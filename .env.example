# ChinaCarsMA — environment configuration
# Copy to .env.local and fill in the values.

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-03-14"

# Optional: server-only token for draft previews and protected revalidate route
SANITY_API_READ_TOKEN=""
SANITY_REVALIDATE_SECRET=""

# Public site URL (canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL="https://chinacarsma.com"

# --- Formulaire de contact + espace admin (Supabase) ---
# À définir dans Vercel (Project Settings > Environment Variables) ET en local (.env.local).

# URL du projet Supabase (Générateur_offres) qui héberge la table contact_messages
SUPABASE_URL="https://tqrhxhoqqktnhttzmoqt.supabase.co"

# Clé "service_role" (SECRÈTE) — Supabase Dashboard > Project Settings > API > service_role.
# Utilisée uniquement côté serveur, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=""

# Mot de passe d'accès au tableau de bord admin (/admin). Choisissez une valeur forte.
ADMIN_PASSWORD=""
