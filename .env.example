# ChinaCarsMA — environment configuration
# Copy this file to `.env.local` and fill in the values.

# Sanity CMS — required to fetch content
VITE_SANITY_PROJECT_ID=""
VITE_SANITY_DATASET="production"
VITE_SANITY_API_VERSION="2024-03-14"

# Public site URL (used for canonical, OG tags, sitemap)
VITE_SITE_URL="https://chinacarsma.com"
