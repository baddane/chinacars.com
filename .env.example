# ChinaCarsMA — environment configuration
# Copy to .env.local and fill in the values.

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-03-14"

# Optional: server-only token for draft previews and protected revalidate route
SANITY_API_READ_TOKEN=""
SANITY_REVALIDATE_SECRET=""

# Public site URL (canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL="https://vehiculeschinois.com"

# Google Analytics 4 — Measurement ID (ex: G-XXXXXXXXXX)
# Laisser vide pour désactiver le tracking
NEXT_PUBLIC_GA_ID=""

# Google AdSense — Publisher ID (ex: ca-pub-XXXXXXXXXXXXXXXX)
# Laisser vide jusqu'à l'approbation AdSense
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=""

# Email — formulaire de contact et newsletter (Resend)
# Créer un compte sur https://resend.com et générer une clé API
RESEND_API_KEY=""
CONTACT_EMAIL="contact@vehiculeschinois.com"
# ID de l'audience Resend pour la newsletter (Resend > Audiences > créer une audience)
RESEND_AUDIENCE_ID=""
